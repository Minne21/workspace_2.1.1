#ifndef HAL_SERIAL_H_
#define HAL_SERIAL_H_

/*

* uart_dma.h
*
* Non-blocking UART + DMA module (HAL)
*
* * RX: circular DMA + IDLE (HAL_UARTEx_ReceiveToIdle_DMA)
* * TX: software queue + HAL DMA transmit chaining
*
* Configure CubeMX:
* * Enable USART2 (or change huart2 -> your UART)
* * Enable DMA for RX (circular) and TX (normal)
* * Enable IDLE or use HAL_UARTEx_ReceiveToIdle_DMA (we use this API)
*
* Usage:
* UART_DMA_Init();                       // after MX_..._Init()
* UART_DMA_Send(buf, len);               // non-blocking
* int n = UART_DMA_Available();
* if(n) c = UART_DMA_Read();             // -1 when empty
*

*/

#ifndef UART_DMA_H_
#define UART_DMA_H_

#include <stdint.h>
#include <stddef.h>
#include <string.h>
#include "stm32g4xx_hal.h"

#ifdef __cplusplus
extern "C" {
#endif

// Default buffer sizes (change before compile if desired)
#ifndef UART_DMA_RX_DMA_BUF_SIZE
#define UART_DMA_RX_DMA_BUF_SIZE   256U
#endif

#ifndef UART_DMA_RX_FIFO_SIZE
#define UART_DMA_RX_FIFO_SIZE       512U
#endif

#ifndef UART_DMA_TX_BUF_SIZE
#define UART_DMA_TX_BUF_SIZE       512U
#endif

// Initialize module. Must be called after HAL/CubeMX peripheral init.
HAL_StatusTypeDef UART_DMA_Init(void);

// Non-blocking send of data. Copies data into TX queue and starts DMA if idle.
// Returns number of bytes actually queued (may be < len if queue full).
size_t UART_DMA_Send(const uint8_t *data, size_t len);

// Convenience: sends a null-terminated C string (non-blocking).
// Returns bytes queued.
static inline size_t UART_DMA_SendString(const char *s) {
return UART_DMA_Send((const uint8_t*)s, (s != NULL) ? strlen(s) : 0);
}

// Returns number of bytes available in RX FIFO
size_t UART_DMA_Available(void);

// Read one byte from RX FIFO. Returns -1 if empty.
int UART_DMA_Read(void);

// Peek next byte without removing (returns -1 if empty)
int UART_DMA_Peek(void);

// Flush RX FIFO
void UART_DMA_FlushRx(void);

// Helper: printf-like (unsafe inside IRQ). Uses vsnprintf and UART_DMA_Send.
// Returns bytes queued.
size_t UART_DMA_Printf(const char *fmt, ...);

// Expose DMA buffer pointer and size if you want to parse in-place
const uint8_t *UART_DMA_RxDmaBufferPtr(void);
size_t UART_DMA_RxDmaBufferSize(void);

// Callbacks - weak versions are provided in .c.
// If you need to hook into events implement these in your app.
void UART_DMA_RxPacketCallback(const uint8_t *data, size_t len); // called when new bytes moved to FIFO (may be called frequently)
void UART_DMA_TxCompleteCallback(void); // called when TX queue drained (optional)

#ifdef __cplusplus
}
#endif

#endif // UART_DMA_H_


#endif /* HAL_SERIAL_H_ */
