// ADC
#define ADC_MAX       4095.0f     // 12-bit ADC
#define VREF          3.3f

// NTC
#define R_FIXED       4700.0f     // 4.7k resistor
#define R0            10000.0f    // NTC 10k at 25°C
#define BETA          3435.0f
#define T0            298.15f     // 25°C in Kelvin

// Input voltage
#define R_TOP          169000.0f  // R68 = 169k
#define R_BOTTOM       18000.0f   // R76 = 18k
#define VBUS_SCALE     ((R_TOP + R_BOTTOM) / R_BOTTOM)   // ~9.886

// Current1,2,3
#define R_SHUNT        0.003f
#define GAIN_POS       64.0f
#define GAIN_NEG      -63.0f

#define K_CURRENT 		(1.0f / (GAIN_POS * R_SHUNT))	//20.833f		// K_CURRENT = 1 / (Rshunt x Gain) = 1/(0.003x16)


/* =========================
 * Configuration
 * ========================= */
#define AS5600_ADDR        (0x36 << 1)   // 7-bit address shifted for HAL
#define AS5600_RAW_ANGLE   0x0C

/* =========================
 * Static variables
 * ========================= */
static uint8_t  i2c_rx_buff[2];
static volatile uint16_t raw_angle_latest = 0;
static volatile uint8_t  data_ready = 0;
static volatile uint8_t  dma_busy = 0;

/* =========================
 * Internal helper
 * ========================= */
static void AS5600_Start_DMA(void)
{
    if (dma_busy) return;

    if (HAL_I2C_GetState(&hi2c1) == HAL_I2C_STATE_READY)
    {
        dma_busy = 1;

        HAL_I2C_Mem_Read_DMA(&hi2c1,
                             AS5600_ADDR,
                             AS5600_RAW_ANGLE,
                             I2C_MEMADD_SIZE_8BIT,
                             i2c_rx_buff,
                             2);
    }
}

/* =========================
 * Public API
 * ========================= */

/**
 * @brief Initialize AS5600 DMA reading
 */
void AS5600_Init(void)
{
    dma_busy = 0;
    data_ready = 0;

    AS5600_Start_DMA();
}

/**
 * @brief Call inside 20kHz FOC ISR (very fast, safe)
 */
void AS5600_Update(void)
{
    if (data_ready)
    {
        uint16_t raw = raw_angle_latest & 0x0FFF;

        foc.mech_rad = ((float)raw / 4096.0f) * TWO_PI;

        data_ready = 0;
    }

    /* Ensure DMA keeps running */
    AS5600_Start_DMA();
}

/**
 * @brief Optional: get latest raw angle
 */
uint16_t AS5600_GetRaw(void)
{
    return raw_angle_latest;
}

/**
 * @brief Optional: bus recovery (call in slow loop)
 */
void AS5600_CheckBus(void)
{
    if (HAL_I2C_GetError(&hi2c1) != HAL_I2C_ERROR_NONE)
    {
        HAL_I2C_DeInit(&hi2c1);
        HAL_I2C_Init(&hi2c1);

        dma_busy = 0;
        AS5600_Start_DMA();
    }
}

/* =========================
 * HAL CALLBACKS
 * ========================= */

/**
 * @brief DMA complete callback (CRITICAL SECTION)
 */
void HAL_I2C_MemRxCpltCallback(I2C_HandleTypeDef *hi2c)
{
    if (hi2c == &hi2c1)
    {
        uint16_t raw = ((uint16_t)i2c_rx_buff[0] << 8) |
                        (uint16_t)i2c_rx_buff[1];

        raw_angle_latest = raw;
        data_ready = 1;

        dma_busy = 0;
    }
}

/**
 * @brief DMA error callback
 */
void HAL_I2C_ErrorCallback(I2C_HandleTypeDef *hi2c)
{
    if (hi2c == &hi2c1)
    {
        dma_busy = 0;
    }
}

