uint16_t ADC1_VAL[4];		// [0] Vbus, [1] TempC, [2] PhaseU_A, [3] Potentiometer
uint16_t ADC2_VAL[2];		// [0] PhaseV_A, [1] PhaseW_A

float offset_phaseA = 0.0f;
float offset_phaseB = 0.0f;
float offset_phaseC = 0.0f;

float tempC, Vbus;
float PhaseU_A, PhaseV_A, PhaseW_A;

// for interrupt
volatile int isADCFinished = 0;

// ADC IT for motor current sense, and votlage/temperature monitoring
void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef *hadc) __attribute__((section (".ccmram")));

void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef *hadc)
{
	// Remove the Up/Down counting check.
	// If TRGO is set to Update Event, this ISR only fires at the bottom of PWM.

    if(hadc == &hadc1)
    {
        // 1. Compute Phase A Current
        // Using a single linear gain K_CURRENT. Standard B-G431-ESC1 gain is ~20.83
        PhaseU_A = ((float)ADC1_VAL[2] - offset_phaseA) * (VREF / 4096.0f) * K_CURRENT;

        // 2. Housekeeping (Lower priority). Timer4 period is getting longer due to Vbus and TempC. it should be converted to isADCFinished.
        NTC_GetTemperature();
        Get_VBUS_Voltage();

    }

    if (hadc == &hadc2)
    {
        // 3. Compute Phase B and C
        PhaseV_A = ((float)ADC2_VAL[0] - offset_phaseB) * (VREF / 4096.0f) * K_CURRENT;
        PhaseW_A = ((float)ADC2_VAL[1] - offset_phaseC) * (VREF / 4096.0f) * K_CURRENT;
    }

	isADCFinished = 1;



#if reg
	// hardware error clears torque enable register and disable FOC torque controller
	if( regs[REG_HARDWARE_ERROR_STATUS] != 0 )
	{
		// disable motor control
//		UART_DMA_Printf("%d \r\n", regs[REG_HARDWARE_ERROR_STATUS]);
	}
	else
	{
		API_FOC_Torque_Update();
//		UART_DMA_Printf("ADC \r\n");
	}
#endif

}

void Calibrate_All_Offsets(void)
{
    uint32_t sumA = 0, sumB = 0, sumC = 0;
    int samples = 1000;

    for(int i = 0; i < samples; i++) {
        HAL_ADC_Start(&hadc1);
        HAL_ADC_Start(&hadc2);
        HAL_ADC_PollForConversion(&hadc1, 10);
        sumA += ADC1_VAL[2];
        sumB += ADC2_VAL[0];
        sumC += ADC2_VAL[1];
    }
    // Set global offsets as raw ADC counts (usually around 2048)
    offset_phaseA = (float)sumA / samples;
    offset_phaseB = (float)sumB / samples;
    offset_phaseC = (float)sumC / samples;
}



// compute temperature in Celsius
float NTC_GetTemperature(void)
{
	// Convert ADC to voltage
    float V_NTC = (ADC1_VAL[1] / ADC_MAX) * VREF;

    // Compute NTC resistance from divider equation
    float R_NTC = (VREF / V_NTC - 1.0f) * R_FIXED;

    // Temperature (Kelvin) using Beta equation
    float tempK = 1.0f / ( (1.0f / T0) + (1.0f / BETA) * logf(R_NTC / R0) );
//    float tempK = BETA * T0 / ( BETA - T0*logf(R0/r_ntc) );		//B-G431B-ESC1-v3

    // Convert to Celsius
    tempC = tempK - 273.15f;

#if reg
    // apply thermal protection and update hardware error register
	float const max_temperature_C = regs[REG_TEMPERATURE_LIMIT];
	if(NTC_tempC > max_temperature_C)
	{
		// set overheating error
		regs[REG_HARDWARE_ERROR_STATUS] |= 1UL << HW_ERROR_BIT_OVERHEATING;
		//HAL_Serial_Print(&serial,"h");
	}
	else if( ((regs[REG_HARDWARE_ERROR_STATUS]&(1UL << HW_ERROR_BIT_OVERHEATING))!=0) ) // hard-coded hysteresis 12°C
	{
		if(NTC_tempC < max_temperature_C-12.0f)
			// clear overheating error
			regs[REG_HARDWARE_ERROR_STATUS] &= ~(1UL << HW_ERROR_BIT_OVERHEATING);
		// wait for cooling
	}
	else
	{
		// clear overheating error
		regs[REG_HARDWARE_ERROR_STATUS] &= ~(1UL << HW_ERROR_BIT_OVERHEATING);
	}
#endif

    return tempC;
}

// compute input voltage
float Get_VBUS_Voltage(void)
{
    uint16_t adc = ADC1_VAL[0];

    // Convert ADC to voltage on VBUS_SENS pin
    float v_adc = (adc / ADC_MAX) * VREF;

    // Convert to actual input voltage
    Vbus = v_adc * VBUS_SCALE;

#if reg
	// apply voltage protection and update
	float const min_voltage_V = regs[REG_LOW_VOLTAGE_LIMIT];
	float const max_voltage_V = regs[REG_HIGH_VOLTAGE_LIMIT];
	if((Input_V > max_voltage_V)||(Input_V < min_voltage_V))
	{
		// set voltage error
		regs[REG_HARDWARE_ERROR_STATUS] |= 1UL << HW_ERROR_BIT_VOLTAGE;
		//HAL_Serial_Print(&serial,"v");
	}
	else
	{
		// clear voltage error
		regs[REG_HARDWARE_ERROR_STATUS] &= ~(1UL << HW_ERROR_BIT_VOLTAGE);
	}
#endif

    return Vbus;
}










