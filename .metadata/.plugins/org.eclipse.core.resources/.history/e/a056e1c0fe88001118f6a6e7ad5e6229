extern TIM_HandleTypeDef htim4;
extern AS5047_Enc_t motor_enc;

void AS5047_Enc_Init(AS5047_Enc_t *enc) {
    enc->index_found = 0;
    enc->total_count = 0;
    enc->mech_rad = 0.0f;

    HAL_TIM_Encoder_Start(&htim4, TIM_CHANNEL_ALL);
    enc->last_cnt = __HAL_TIM_GET_COUNTER(&htim4);
}

// PB8 EXTI 인터럽트 발생 시 main.c에서 호출할 함수
void AS5047_Enc_Index_Callback(AS5047_Enc_t *enc) {
    // 처음 Index를 만났을 때 타이머를 0으로 리셋하여 물리적 영점 정렬
    if (enc->index_found == 0) {
        __HAL_TIM_SET_COUNTER(&htim4, 0);
        enc->last_cnt = 0;
        enc->index_found = 1;
    }
}

void AS5047_Enc_Update(AS5047_Enc_t *enc) {
    enc->cnt = (int32_t)__HAL_TIM_GET_COUNTER(&htim4);

    // 1. 변화량 계산 (16비트 오버플로우 방지)
    int16_t diff = (int16_t)(enc->cnt - enc->last_cnt);
    enc->total_count += diff;

    // 2. 기계적 라디안 계산 (0 ~ 2*PI)
    float temp_rad = (float)(enc->cnt % (int)ENCODER_RES) * (2.0f * 3.14159265f / ENCODER_RES);
    if (temp_rad < 0) temp_rad += (2.0f * 3.14159265f);
    enc->mech_rad = temp_rad;

    // 3. 전기적 라디안 계산 (fmodf 제거 버전)
    // 단순히 극쌍수를 곱한 뒤, 2*PI 범위를 벗어날 경우 뺄셈/덧셈으로 처리합니다.
    enc->elec_rad = enc->mech_rad * POLE_PAIRS;

    // while문을 사용하여 2*PI 범위를 강제로 맞춤 (보통 1~2번의 루프로 끝남)
    while (enc->elec_rad < 0.0f) enc->elec_rad += 6.2831853f;
    while (enc->elec_rad >= 6.2831853f) enc->elec_rad -= 6.2831853f;

     // 4. 속도 계산 (RPM)
    enc->velocity_rpm = ((float)diff / ENCODER_RES) * (60.0f / SAMPLING_TIME_S);

    enc->last_cnt = enc->cnt;
}

void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin) {
    if (GPIO_Pin == GPIO_PIN_8) { // PB8 Index 신호
        AS5047_Enc_Index_Callback(&motor_enc);
    }
}


