/**
 * @brief Blocking routine intended for startup phase to profile sensor offsets.
 *        Averages out 1000 resting hardware voltage levels to calibrate out op-amp bias errors.
 */

volatile uint8_t calibration_done = 0;

void Calibrate_All_Offsets(void) {
    uint32_t sumA = 0, sumB = 0, sumC = 0;
    int samples = 100;

    for(int i = 0; i < samples; i++) {
        /*
           DMA가 상시 구동 중이므로 HAL_ADC_Start나 PollForConversion은 불필요합니다.
           단, 새로운 ADC 데이터가 DMA를 통해 버퍼로 들어올 시간(예: 1ms)을 기다려줍니다.
           (PWM 주기가 고속이므로 1ms면 수회~수십회의 ADC 갱신이 새로 일어납니다)
        */
        HAL_Delay(1);

        // 갱신된 DMA 버퍼에서 실시간 raw 값을 안전하게 누적
        sumA += ADC1_VAL[2];
        sumB += ADC2_VAL[0];
        sumC += ADC2_VAL[1];
    }

    // 1000번 수집된 완전한 갱신 데이터의 평균값 계산 (Raw ADC 기준 대략 2048 근처)
    offset_phaseA = (float)sumA / samples;
    offset_phaseB = (float)sumB / samples;
    offset_phaseC = (float)sumC / samples;

    calibration_done = 1;
}


/**
 * @brief Converts NTC voltage divider data to actual temperatures in Celsius
 * .@return Computed board temperature in Celsius.
*/
float NTC_GetTemperature(void)
{
	// Convert ADC to voltage
	// Map raw sampled bit information to actual analog voltage drop
    float V_NTC = (ADC1_VAL[1] / ADC_MAX) * VREF;

    // Rearrange voltage divider math to find real time ohm resistance profile
    float R_NTC = (VREF / V_NTC - 1.0f) * R_FIXED;

    // Evaluate absolute Kelvin scaling via Beta representation of Steinhart-Hart equation
    float tempK = 1.0f / ( (1.0f / T0) + (1.0f / BETA) * logf(R_NTC / R0) );
//    float tempK = BETA * T0 / ( BETA - T0*logf(R0/r_ntc) );		//B-G431B-ESC1-v3

    // Scale Kelvin back down to human readable Celsius metrics
    tempC = tempK - 273.15f;

// for the future protection
#if reg
    /* Automatic Thermal Overload Fault Tripping Logic */
    // apply thermal protection and update hardware error register
	float const max_temperature_C = regs[REG_TEMPERATURE_LIMIT];
	if(tempC > max_temperature_C)
	{
		// Trigger thermal hardware error flag state
		// set overheating error
		regs[REG_HARDWARE_ERROR_STATUS] |= 1UL << HW_ERROR_BIT_OVERHEATING;
		//HAL_Serial_Print(&serial,"h");
	}
	else if( ((regs[REG_HARDWARE_ERROR_STATUS]&(1UL << HW_ERROR_BIT_OVERHEATING))!=0) ) // hard-coded hysteresis 12°C
	{
		// Hard-coded structural 12°C cooling hysteresis loop protection parameters
		if(tempC < max_temperature_C-12.0f)
			// clear overheating error
			regs[REG_HARDWARE_ERROR_STATUS] &= ~(1UL << HW_ERROR_BIT_OVERHEATING);
		// wait for cooling
	}
	else
	{
		// clear overheating error
		regs[REG_HARDWARE_ERROR_STATUS] &= ~(1UL << HW_ERROR_BIT_OVERHEATING);
	}
#endif

    return tempC;
}



/**
 * @brief Samples analog hardware scale levels to calculate the primary DC power supply bus voltage.
 * @return Evaluated main bus input voltage profile (Volts).
 * */
// compute input voltage
float Get_VBUS_Voltage(void)
{
    uint16_t adc = ADC1_VAL[0];		// Map raw bit stream directly back into board monitoring trace voltage levels

    // Convert ADC to voltage on VBUS_SENS pin
    float v_adc = (adc / ADC_MAX) * VREF;	// Apply voltage divider ratio to derive the unscaled structural main power bus value

    // Convert to actual input voltage
    Vbus = v_adc * VBUS_SCALE;

// for the future protection
#if reg
    /* Voltage Rails Under/Overbound Threshold Enforcement Controls */
	// apply voltage protection and update
	float const min_voltage_V = regs[REG_LOW_VOLTAGE_LIMIT];
	float const max_voltage_V = regs[REG_HIGH_VOLTAGE_LIMIT];
	if((Vbus > max_voltage_V)||(Vbus < min_voltage_V))
	{
		// Flag bus power structure instability errors
		// set voltage error
		regs[REG_HARDWARE_ERROR_STATUS] |= 1UL << HW_ERROR_BIT_VOLTAGE;
		//HAL_Serial_Print(&serial,"v");
	}
	else
	{
		// clear voltage error
		regs[REG_HARDWARE_ERROR_STATUS] &= ~(1UL << HW_ERROR_BIT_VOLTAGE);
	}
#endif

    return Vbus;
}



void AS5047_Check_PPR(void)
{
    int32_t start_count;
    int32_t end_count;
    int32_t delta_count;

    float counts_per_rev;
    float ppr;

    const int NUM_REV = 3;
    const uint32_t TEST_TIME_MS = 10000;

    UART_DMA_Printf("\r\n");
    UART_DMA_Printf("========================================\r\n");
    UART_DMA_Printf("       AS5047P PPR CHECK\r\n");
    UART_DMA_Printf("========================================\r\n");
    UART_DMA_Printf("TIM4 Encoder Mode: 4X\r\n");
    UART_DMA_Printf("\r\n");

    // Start encoder
    HAL_TIM_Encoder_Start(&htim4, TIM_CHANNEL_ALL);

    // Reset counter
    __HAL_TIM_SET_COUNTER(&htim4, 32768);

    UART_DMA_Printf("Starting in 3 seconds...\r\n");
    HAL_Delay(3000);

    // Reset counter again immediately before measurement
    __HAL_TIM_SET_COUNTER(&htim4, 32768);

    start_count = 32768;

    UART_DMA_Printf("\r\n");
    UART_DMA_Printf("========================================\r\n");
    UART_DMA_Printf("START MEASUREMENT\r\n");
    UART_DMA_Printf("========================================\r\n");

    UART_DMA_Printf("Rotate shaft EXACTLY %d revolutions.\r\n",
                    NUM_REV);

    UART_DMA_Printf("You have %lu seconds.\r\n",
                    TEST_TIME_MS / 1000);

    UART_DMA_Printf("\r\n");

    // Measurement time
    HAL_Delay(TEST_TIME_MS);

    end_count = (int32_t)__HAL_TIM_GET_COUNTER(&htim4);

    /*
     * Calculate signed difference.
     *
     * Since TIM4 is a 16-bit counter, handle rollover.
     */
    delta_count = end_count - start_count;

    if (delta_count > 32767)
    {
        delta_count -= 65536;
    }
    else if (delta_count < -32768)
    {
        delta_count += 65536;
    }

    // We only care about magnitude for PPR measurement
    int32_t abs_count = delta_count;

    if (abs_count < 0)
    {
        abs_count = -abs_count;
    }

    counts_per_rev =
        (float)abs_count / (float)NUM_REV;

    // TIM4 is operating in 4X mode
    ppr = counts_per_rev / 4.0f;

    UART_DMA_Printf("\r\n");
    UART_DMA_Printf("========================================\r\n");
    UART_DMA_Printf("RESULT\r\n");
    UART_DMA_Printf("========================================\r\n");

    UART_DMA_Printf("Number of revolutions = %d\r\n",
                    NUM_REV);

    UART_DMA_Printf("Start CNT             = %ld\r\n",
                    start_count);

    UART_DMA_Printf("End CNT               = %ld\r\n",
                    end_count);

    UART_DMA_Printf("Delta CNT             = %ld\r\n",
                    delta_count);

    UART_DMA_Printf("Absolute counts       = %ld\r\n",
                    abs_count);

    UART_DMA_Printf("Counts / revolution   = %.1f\r\n",
                    counts_per_rev);

    UART_DMA_Printf("AS5047P PPR           = %.1f\r\n",
                    ppr);

    UART_DMA_Printf("========================================\r\n");
}
