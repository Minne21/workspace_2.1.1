/*                      HARDWARE & MATHEMATICAL DEFINITIONS                   */
/* ========================================================================== */


// Input voltage
#define R_TOP       169000.0f  	// R68 = 169k
#define R_BOTTOM    18000.0f   	// R76 = 18k
#define VBUS_SCALE  ((R_TOP + R_BOTTOM) / R_BOTTOM)   // ~9.886

#define K_CURRENT 	20.833f		// K_CURRENT 20.833f, GAIN_POS 16, R_SHUNT 3m
								// K_CURRENT 10.417f, GAIN_POS 32, R_SHUNT 3m
								// K_CURRENT 5.208f, GAIN_POS 64, R_SHUNT 3m

/* ADC Configuration */
#define ADC_MAX 	4095.0f 	// Maximum scale value for a 12-bit ADC
#define VREF 		3.3f        // Microcontroller analog reference voltage (Volts)

/* NTC Thermistor Parameters (Voltage Divider to Temperature) */
#define R_FIXED 	4700.0f     // High-side bias resistor (4.7k Ohms)
#define R0 			10000.0f    // Baseline NTC resistance at 25°C (10k Ohms)
#define BETA 		3435.0f     // NTC Beta coefficient material constant
#define T0 			298.15f     // 25°C baseline temperature converted to Kelvin

/* DC Bus Voltage Monitor Resistor Divider Network */
#define R_TOP 		169000.0f   // High-side sensing resistor (R68 = 169k Ohms)
#define R_BOTTOM 	18000.0f   	// Low-side sensing resistor  (R76 = 18k Ohms)

// Scale factor to map measured ADC voltage back to the actual VBUS voltage (~9.886)
#define VBUS_SCALE ((R_TOP + R_BOTTOM) / R_BOTTOM)

/* Current Shunt Amplifier Scaling Coefficients */
#define K_CURRENT 	20.833f     // K_CURRENT 20.833f, GAIN_POS 16, R_SHUNT 3m
                              	// K_CURRENT 10.417f, GAIN_POS 32, R_SHUNT 3m
                              	// K_CURRENT 5.208f,  GAIN_POS 64, R_SHUNT 3m


